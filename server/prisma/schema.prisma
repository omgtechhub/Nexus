generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  STAFF
  VIEWER
}

enum StoreStatus {
  ACTIVE
  PAUSED
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
}

enum ShipmentStatus {
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  EXCEPTION
}

enum ShippingRateType {
  FLAT_RATE
  FREE_SHIPPING
  WEIGHT_BASED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIAL
  FULFILLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
  SHIPPING
}

enum DiscountStatus {
  ACTIVE
  SCHEDULED
  EXPIRED
}

enum NotificationType {
  SUCCESS
  WARNING
  INFO
  ERROR
}

enum InventoryMovementType {
  INITIAL
  MANUAL_ADJUSTMENT
  ORDER_PLACED
  ORDER_CANCELLED
  RESTOCK
}

enum OrderAddressType {
  SHIPPING
  BILLING
}

enum PlatformRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
}

/// Which portal a user belongs to. Stored, never inferred: the previous code
/// guessed from the `plan` string and the presence of a store, which made every
/// signed-in user look like a seller.
enum AccountType {
  CUSTOMER
  SELLER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  passwordHash     String
  name             String
  avatar           String?
  phone            String?
  /// Authoritative portal assignment. ADMIN is expressed by platformRole.
  accountType      AccountType   @default(SELLER)
  isVerified       Boolean       @default(false)
  emailVerifiedAt  DateTime?
  twoFactorEnabled Boolean       @default(false)
  plan             String        @default("pro")
  platformRole     PlatformRole?
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sessions           Session[]
  ownedStores        Store[]
  memberships        StoreMember[]
  notifications      Notification[]
  /// One global identity, one CRM record per store it has bought from.
  customerProfiles   Customer[]
  oauthAccounts      OAuthAccount[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  aiConversations    AiConversation[]
  productReviews     ProductReview[]
  voiceProfiles      VoiceProfile[]

  @@index([accountType])
}

/// Links a Nexus user to a verified external provider identity, so a returning
/// OAuth user is matched on the provider's stable subject id, not just email.
model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Single-use password reset grant. Only the SHA-256 hash of the token is
/// stored, so a database read cannot be replayed to take over an account.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Store {
  id        String      @id @default(uuid())
  name      String
  domain    String      @unique
  currency  String      @default("USD — US Dollar")
  timezone  String      @default("America/New_York")
  industry  String      @default("Fashion & Apparel")
  status    StoreStatus @default(ACTIVE)
  ownerId   String
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  members             StoreMember[]
  products            Product[]
  categories          ProductCategory[]
  inventoryItems      InventoryItem[]
  inventoryMovements  InventoryMovement[]
  customers           Customer[]
  orders              Order[]
  discounts           Discount[]
  notifications       Notification[]
  settings            StoreSettings?
  storefrontConfig    StorefrontConfig?
  pages               StorePage[]
  navigationMenus     NavigationMenu[]
  invitations         TeamInvitation[]
  customDomains       CustomDomain[]
  auditLogs           AuditLog[]
  payments            Payment[]
  shippingZones       ShippingZone[]
  shipments           Shipment[]
  subscription        Subscription?
  billingCustomer     BillingCustomer?
  billingTransactions BillingTransaction[]
  invoices            Invoice[]
  aiInsights          AiInsight[]
  aiConversations     AiConversation[]
  aiUsageEvents       AiUsageEvent[]
  productReviews      ProductReview[]
  payouts             Payout[]
  payoutAccount       MerchantPayoutAccount?
}

model StoreMember {
  id        String   @id @default(uuid())
  userId    String
  storeId   String
  role      Role     @default(OWNER)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, storeId])
  /// A user may OWN at most one merchant account.
  ///
  /// Enforced by a partial unique index that Prisma cannot express here —
  /// `CREATE UNIQUE INDEX ... ON "StoreMember" ("userId") WHERE "role" =
  /// 'OWNER'`, added in `20261017120000_one_merchant_account_per_owner`.
  /// STAFF and ADMIN memberships are deliberately unconstrained so a person
  /// can still be invited onto someone else's merchant account.
  ///
  /// Without it nothing stopped one user owning several merchant records, and
  /// the code that resolves "the current merchant" had to guess.
}

model Session {
  id           String    @id @default(uuid())
  sessionToken String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([sessionToken])
  @@index([userId])
}

model ProductCategory {
  id          String    @id @default(uuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
}

model Product {
  id              String           @id @default(uuid())
  storeId         String
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title           String
  name            String
  slug            String
  description     String           @default("")
  price           Float
  comparePrice    Float?
  costPrice       Float?
  sku             String
  barcode         String?
  inventoryPolicy String           @default("deny")
  status          ProductStatus    @default(ACTIVE)
  category        String           @default("General")
  categoryId      String?
  productCategory ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags            Json             @default("[]")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  /// Rolling aggregate over PUBLISHED reviews, recomputed in the same
  /// transaction as every review write. Denormalised because the catalogue
  /// sorts and filters on it: computing it per row would be an aggregate
  /// subquery on every marketplace listing.
  ratingAverage   Float            @default(0)
  ratingCount     Int              @default(0)

  images             ProductImage[]
  variants           ProductVariant[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  reviews            ProductReview[]

  @@unique([storeId, slug])
  @@unique([storeId, sku])
  @@index([storeId])
}

model ProductVariant {
  id                String   @id @default(uuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title             String
  sku               String
  price             Float
  comparePrice      Float?
  costPrice         Float?
  barcode           String?
  option1           String?
  option2           String?
  option3           String?
  inventoryQuantity Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]

  @@index([productId])
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  altText    String?
  position   Int      @default(0)
  isPrimary  Boolean  @default(false)
  storageKey String?
  createdAt  DateTime @default(now())

  @@index([productId])
}

model InventoryItem {
  id                String          @id @default(uuid())
  storeId           String
  store             Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sku               String
  stock             Int             @default(0)
  reservedStock     Int             @default(0)
  availableStock    Int             @default(0)
  lowStockThreshold Int             @default(5)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  movements InventoryMovement[]

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([productId])
}

model InventoryMovement {
  id              String                @id @default(uuid())
  storeId         String
  store           Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  productId       String
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  changeQuantity  Int
  newQuantity     Int
  type            InventoryMovementType @default(MANUAL_ADJUSTMENT)
  reason          String?
  referenceId     String?
  createdAt       DateTime              @default(now())

  @@index([storeId])
  @@index([inventoryItemId])
}

model Customer {
  id          String    @id @default(uuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Set when this shopper has a Nexus account. Null for guest checkouts,
  /// which are back-filled on the buyer's next sign-in.
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  email       String
  phone       String?
  location    String?
  avatar      String?
  totalOrders Int       @default(0)
  totalSpent  Float     @default(0)
  lastOrderAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  addresses CustomerAddress[]
  orders    Order[]

  @@unique([storeId, email])
  @@index([storeId])
  @@index([userId])
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  company    String?
  address1   String
  address2   String?
  city       String
  state      String
  zip        String
  country    String
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

model Order {
  id                String            @id @default(uuid())
  storeId           String
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderNumber       String
  customerId        String?
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName      String
  customerEmail     String
  customerPhone     String?
  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  discountCode      String?
  subtotal          Float             @default(0)
  tax               Float             @default(0)
  shipping          Float             @default(0)
  discount          Float             @default(0)
  total             Float
  currency          String            @default("USD")
  notes             String?
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items         OrderItem[]
  addresses     OrderAddress[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  refunds       Refund[]
  shipments     Shipment[]
  reviews       ProductReview[]

  @@unique([storeId, orderNumber])
  @@index([storeId])
  @@index([customerId])
}

model OrderItem {
  id           String          @id @default(uuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productTitle String
  variantTitle String?
  sku          String
  quantity     Int
  price        Float
  total        Float
  createdAt    DateTime        @default(now())

  review       ProductReview?

  @@index([orderId])
  @@index([productId])
}

model OrderAddress {
  id        String           @id @default(uuid())
  orderId   String
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      OrderAddressType @default(SHIPPING)
  firstName String
  lastName  String
  address1  String
  address2  String?
  city      String
  state     String
  zip       String
  country   String
  phone     String?

  @@index([orderId])
}

model OrderStatusHistory {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus
  toStatus    OrderStatus
  note        String?
  createdById String?
  createdAt   DateTime    @default(now())

  @@index([orderId])
}

model Discount {
  id              String         @id @default(uuid())
  storeId         String
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code            String
  type            DiscountType   @default(PERCENTAGE)
  value           String
  redemptions     Int            @default(0)
  maxRedemptions  Int            @default(100)
  status          DiscountStatus @default(ACTIVE)
  minOrderAmount  Float?
  allowedCategory String?
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([storeId, code])
  @@index([storeId])
}

model Notification {
  id        String           @id @default(uuid())
  storeId   String
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(INFO)
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([storeId])
  @@index([userId])
}

model StoreSettings {
  id                String   @id @default(uuid())
  storeId           String   @unique
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeName         String   @default("Aura Apparel Store")
  storeUrl          String   @default("auraapparel")
  currency          String   @default("USD — US Dollar")
  timezone          String   @default("America/New_York")
  industry          String   @default("Fashion & Apparel")
  description       String?  @default("Premium fashion and lifestyle brand.")
  logoUrl           String?
  faviconUrl        String?
  contactEmail      String?  @default("support@auraapparel.com")
  contactPhone      String?  @default("+1 555-0199")
  address           String?  @default("100 Commerce Way, San Francisco, CA 94105")
  announcementText  String   @default("🎉 Flash Sale: Get 20% off all summer collections with code SUMMER20")
  activeTheme       String   @default("nexus-dark")
  primaryColor      String   @default("#FFBD2E")
  secondaryColor    String   @default("#27C93F")
  accentColor       String   @default("#FF5F56")
  fontFamily        String   @default("Inter")
  customDomain      String   @default("auraapparel.com")
  guestCheckout     Boolean  @default(true)
  requireAccount    Boolean  @default(false)
  orderNotesEnabled Boolean  @default(true)

  /// Tax, per store.
  ///
  /// There was no tax configuration at all: checkout applied a hardcoded 8%
  /// to every order in every store, so a Nigerian merchant charged their
  /// customers a US-shaped sales tax nobody had configured and nobody remits.
  ///
  /// Defaults to **off**. A tax rate is a legal declaration about a specific
  /// business in a specific place; inheriting someone else's is worse than
  /// charging nothing, and a merchant who needs it will set it.
  taxEnabled        Boolean  @default(false)
  /// Percentage, e.g. 7.5 for 7.5%. Only read when taxEnabled.
  taxRate           Float    @default(0)
  /// What the line is called on the order summary — "VAT", "Sales tax", "GST".
  taxLabel          String   @default("Tax")
  /// When true, listed prices already include tax, so it is shown as a
  /// component of the total rather than added to it.
  taxInclusive      Boolean  @default(false)

  /// Fallback delivery charge for a store with no shipping zone configured.
  ///
  /// Checkout previously hardcoded $15, free over $100, ignoring the
  /// ShippingZone/ShippingMethod records merchants actually fill in. Those are
  /// now the primary source; these two only apply when a store has none.
  defaultShippingFee      Float  @default(0)
  freeShippingThreshold   Float?
  socialLinks       Json     @default("{}")
  seoTitle          String?
  seoDescription    String?
  socialImage       String?
  updatedAt         DateTime @updatedAt
}

model StorefrontConfig {
  id              String    @id @default(uuid())
  storeId         String    @unique
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  activeTheme     String    @default("nexus-dark")
  draftConfig     Json
  publishedConfig Json?
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model StorePage {
  id             String   @id @default(uuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title          String
  slug           String
  content        String   @default("")
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
}

model NavigationMenu {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  handle    String
  items     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, handle])
  @@index([storeId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model TeamInvitation {
  id        String           @id @default(uuid())
  storeId   String
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email     String
  role      Role             @default(STAFF)
  token     String           @unique
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  invitedBy String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([storeId])
  @@index([token])
}

enum DomainStatus {
  PENDING
  VERIFYING
  VERIFIED
  ACTIVE
  FAILED
}

model CustomDomain {
  id                String       @id @default(uuid())
  storeId           String
  store             Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  domain            String       @unique
  status            DomainStatus @default(PENDING)
  verificationToken String       @unique
  isPrimary         Boolean      @default(false)
  verifiedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([storeId])
}

model AuditLog {
  id         String   @id @default(uuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId     String?
  actorName  String
  actorEmail String
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([storeId])
}

model Payment {
  id                String          @id @default(uuid())
  storeId           String
  store             Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  providerReference String          @unique
  amount            Float
  currency          String          @default("USD")
  status            PaymentStatus   @default(PENDING)
  metadata          Json?

  /// The platform's cut, and what the merchant is owed, both fixed at the
  /// moment the payment settled.
  ///
  /// Captured per payment rather than recomputed from a current rate, so
  /// changing the commission never re-values money already taken. Null until
  /// the payment settles; `merchantNetAmount` is what the payout balance sums.
  platformFeeAmount Float?
  merchantNetAmount Float?
  /// The rate used, kept for the audit trail and for explaining a figure to a
  /// merchant who asks why it is what it is.
  commissionRate    Float?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  transactions Transaction[]
  refunds      Refund[]

  @@index([storeId])
  @@index([orderId])
}

model Transaction {
  id                String   @id @default(uuid())
  paymentId         String
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  storeId           String
  type              String   @default("CHARGE")
  amount            Float
  currency          String   @default("USD")
  status            String   @default("SUCCESS")
  providerReference String?
  rawResponse       Json?
  createdAt         DateTime @default(now())

  @@index([paymentId])
  @@index([storeId])
}

model WebhookEvent {
  id          String          @id @default(uuid())
  storeId     String?
  provider    PaymentProvider
  eventId     String          @unique
  eventType   String
  payload     Json
  processed   Boolean         @default(false)
  processedAt DateTime?
  createdAt   DateTime        @default(now())
}

model Refund {
  id                String   @id @default(uuid())
  paymentId         String
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId           String
  amount            Float
  currency          String   @default("USD")
  reason            String?
  status            String   @default("SUCCESS")
  providerReference String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([paymentId])
  @@index([orderId])
  @@index([storeId])
}

model ShippingZone {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  countries Json     @default("[\"US\"]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  methods ShippingMethod[]

  @@index([storeId])
}

model ShippingMethod {
  id            String           @id @default(uuid())
  zoneId        String
  zone          ShippingZone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  storeId       String
  name          String
  description   String?
  rateType      ShippingRateType @default(FLAT_RATE)
  price         Float            @default(0)
  freeThreshold Float?
  estimatedDays String?          @default("3-5 business days")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([zoneId])
  @@index([storeId])
}

model Shipment {
  id             String         @id @default(uuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId        String
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  carrier        String
  trackingNumber String
  status         ShipmentStatus @default(LABEL_CREATED)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  trackingEvents TrackingEvent[]

  @@index([orderId])
  @@index([storeId])
}

model TrackingEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      String
  location    String?
  description String
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([shipmentId])
}

model SubscriptionPlan {
  id                       String   @id @default(uuid())
  code                     String   @unique
  name                     String
  description              String
  monthlyPrice             Float
  annualPrice              Float
  currency                 String   @default("USD")
  trialDays                Int      @default(14)
  isActive                 Boolean  @default(true)
  displayOrder             Int      @default(0)
  maxProducts              Int      @default(100)
  maxTeamMembers           Int      @default(5)
  maxStores                Int      @default(1)
  storageMb                Int      @default(5000)
  customDomainAllowed      Boolean  @default(true)
  advancedAnalyticsAllowed Boolean  @default(true)
  /// Monthly Nexus IQ token allowance. Null means unlimited.
  aiTokensPerMonth         Int?     @default(1000)
  features                 Json     @default("[]")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]
}

model Subscription {
  id                     String             @id @default(uuid())
  storeId                String             @unique
  store                  Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  billingInterval        BillingInterval    @default(MONTHLY)
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime
  trialEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  cancelledAt            DateTime?
  providerCustomerId     String?
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  events       SubscriptionEvent[]
  transactions BillingTransaction[]
  invoices     Invoice[]

  @@index([storeId])
  @@index([planId])
}

model BillingCustomer {
  id                 String   @id @default(uuid())
  storeId            String   @unique
  store              Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email              String
  name               String
  provider           String   @default("PAYSTACK")
  providerCustomerId String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([storeId])
}

model BillingTransaction {
  id                String        @id @default(uuid())
  storeId           String
  store             Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoiceId         String?
  invoice           Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount            Float
  currency          String        @default("USD")
  type              String        @default("SUBSCRIPTION_CHARGE")
  status            String        @default("SUCCESS")
  provider          String        @default("PAYSTACK")
  providerReference String        @unique
  rawResponse       Json?
  createdAt         DateTime      @default(now())

  @@index([storeId])
  @@index([subscriptionId])
  @@index([invoiceId])
}

model Invoice {
  id             String            @id @default(uuid())
  invoiceNumber  String            @unique
  storeId        String
  store          Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  planId         String?
  plan           SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  status         InvoiceStatus     @default(PAID)
  subtotal       Float
  tax            Float             @default(0)
  total          Float
  currency       String            @default("USD")
  periodStart    DateTime
  periodEnd      DateTime
  issueDate      DateTime          @default(now())
  dueDate        DateTime?
  paidAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  items        InvoiceItem[]
  transactions BillingTransaction[]

  @@index([storeId])
  @@index([subscriptionId])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model SaasWebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String    @unique
  eventType   String
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

model SubscriptionEvent {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  action         String
  fromStatus     String?
  toStatus       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
}

// ---------------------------------------------------------------------------
// Nexus IQ
//
// The provider that writes the prose is pluggable and currently a stub. What is
// NOT pluggable is the evidence: every insight records the store figures it was
// derived from, so a reader can check the claim rather than trust it.
// ---------------------------------------------------------------------------

enum AiInsightKind {
  LOW_STOCK
  OUT_OF_STOCK
  UNFULFILLED_ORDERS
  REVENUE_TREND
  TOP_PRODUCTS
  NO_PRODUCTS
}

enum AiInsightSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AiInsightStatus {
  READY
  DISMISSED
}

model AiInsight {
  id       String            @id @default(uuid())
  storeId  String
  store    Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind     AiInsightKind
  severity AiInsightSeverity @default(INFO)
  status   AiInsightStatus   @default(READY)
  title    String
  body     String
  /// The store figures this insight was computed from.
  evidence Json              @default("{}")
  /// Which provider and model phrased it, so stub output is never mistaken for a model's.
  provider String            @default("stub")
  model    String            @default("stub-v1")

  generatedAt DateTime  @default(now())
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([storeId, status])
  @@index([storeId, kind])
}

model AiConversation {
  id      String  @id @default(uuid())
  storeId String
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  title   String  @default("New conversation")

  messages  AiMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([storeId, updatedAt])
}

enum AiMessageRole {
  USER
  ASSISTANT
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiMessageRole
  content        String
  provider       String?
  model          String?
  tokensIn       Int            @default(0)
  tokensOut      Int            @default(0)
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

enum AiUsageKind {
  CHAT
  INSIGHTS
}

/// An append-only ledger. The period total is summed from it rather than kept
/// as a counter, so usage can always be reconciled against what produced it.
model AiUsageEvent {
  id        String      @id @default(uuid())
  storeId   String
  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind      AiUsageKind
  provider  String
  model     String
  tokensIn  Int         @default(0)
  tokensOut Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([storeId, createdAt])
}

enum ReviewStatus {
  PUBLISHED
  /// Set by a platform admin when a review breaks the content rules. A
  /// merchant deliberately cannot reach this: a seller who can hide its own
  /// one-star reviews makes every rating on the marketplace worthless.
  HIDDEN
}

/// A rating and comment left by a shopper who actually bought the product.
///
/// The verification is structural rather than a flag: every review points at
/// the `OrderItem` that entitles it. There is no code path that writes a
/// review without one, so "verified purchase" is not a claim the row makes
/// about itself — it is the row's foreign key. That also makes the rule
/// auditable after the fact: the purchase behind any review is one join away.
///
/// Nothing here is ever seeded. A product with no buyers has no reviews and a
/// rating of zero, and the UI says so rather than inventing a number.
model ProductReview {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Denormalised from the product so a merchant can list the reviews across
  /// its own catalogue without joining through every product.
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The purchase that entitles this review. `Restrict` because deleting the
  /// evidence would silently turn a verified review into an unverified one;
  /// the review has to go first.
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  /// 1-5. Enforced by a check constraint in the migration as well as by the
  /// request validator, because the aggregate is only meaningful if the range
  /// holds for rows written by any future code path.
  rating Int
  title  String?
  body   String

  status ReviewStatus @default(PUBLISHED)

  /// A public answer from the merchant. One per review, and it cannot change
  /// the rating.
  merchantReply     String?
  merchantRepliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One review per shopper per product, however many times they bought it.
  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([storeId, status])
  @@index([userId])
}

/// Which portal a voice profile was enrolled for.
///
/// One person can hold more than one Nexus account type, and the voice gate is
/// per surface: enrolling as a seller must not silently unlock the admin
/// console. The pair (userId, portal) is therefore the identity, not userId.
enum VoicePortal {
  SELLER
  CUSTOMER
  ADMIN
}

/// An enrolled voice, used to decide whether Nexus IQ answers at all.
///
/// **This is not a security boundary, and nothing may treat it as one.** A
/// recording of the owner defeats it, and so will a good enough synthesis.
/// What stands between a request and the data is the session cookie and the
/// portal guards, exactly as it does for every other route; this only decides
/// whether a spoken turn is acted on. Lifted from Jarvis, whose speaker module
/// makes the same point: gate activation, never permissions.
model VoiceProfile {
  id     String      @id @default(uuid())
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  portal VoicePortal

  /// Mean of the enrolment embeddings, unit-normalised. 256 floats from
  /// WeSpeaker ResNet34.
  centroid Json
  /// Per-condition means ("close", "across the room"). Verification scores
  /// against the nearest of these rather than the centroid alone, so an
  /// utterance from further away is compared with how this voice sounds from
  /// further away.
  anchors  Json @default("[]")

  /// Measured at enrolment by leave-one-out, never hardcoded. Jarvis's first
  /// version set the bar just under how alike the enrolment samples were,
  /// which locked the owner out the moment they spoke from a doorway.
  threshold   Float
  /// Mean pairwise similarity of the enrolment samples: how consistent this
  /// voice was with itself on the day.
  consistency Float
  sampleCount Int

  embedder String
  model    String
  /// False when a non-neural fallback produced the vectors, so the UI can say
  /// so rather than implying an accuracy it does not have.
  isNeural Boolean @default(true)

  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, portal])
  @@index([userId])
}


/// How a payout reached the merchant.
enum PayoutMethod {
  /// Recorded by a platform admin after paying by their own means. The
  /// default, because automated transfers need verified bank details and a
  /// funded provider balance.
  MANUAL
  /// Executed through the payment provider's transfer API.
  PROVIDER_TRANSFER
}

enum PayoutStatus {
  /// Requested or scheduled; the money has not moved.
  PENDING
  /// Handed to the provider, awaiting confirmation.
  PROCESSING
  /// Confirmed as received by the merchant.
  PAID
  FAILED
  /// Paid, then reversed by the provider or the bank.
  REVERSED
}

/// Where a merchant's money is sent.
///
/// The full account number is deliberately **not** stored. It is needed once,
/// to register the destination with the payment provider, which returns a
/// recipient token used for every later transfer; only that token and the last
/// four digits — enough for a merchant to recognise their own account — are
/// kept. Holding full bank details for every merchant is a liability with no
/// operational benefit.
model MerchantPayoutAccount {
  id                  String   @id @default(uuid())
  storeId             String   @unique
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  accountName         String
  bankName            String
  /// Provider's bank identifier (Paystack `bank.code`).
  bankCode            String
  accountNumberLast4  String
  /// Provider recipient token, used in place of the account number.
  providerRecipientId String?
  provider            String   @default("PAYSTACK")
  /// Set once the provider confirms the account resolves to `accountName`.
  verifiedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([storeId])
}

/// A settlement of a merchant's balance.
///
/// Before this existed there was no payout subsystem at all: every customer
/// payment landed in the platform's own gateway account with no record of what
/// was owed to which merchant, while the seller-facing assistant already told
/// merchants their payouts were visible in the dashboard.
model Payout {
  id                String       @id @default(uuid())
  storeId           String
  store             Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Human-readable, shown to the merchant.
  reference         String       @unique
  amount            Float
  currency          String       @default("USD")
  status            PayoutStatus @default(PENDING)
  method            PayoutMethod @default(MANUAL)
  /// Provider transfer id, when executed through one.
  providerReference String?
  /// The window of earnings this settles, for the merchant's statement.
  periodStart       DateTime?
  periodEnd         DateTime?
  /// Admin who created it; null for a scheduled job.
  initiatedByUserId String?
  note              String?
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([storeId])
  @@index([status])
}
