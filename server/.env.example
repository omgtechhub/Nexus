# Nexus Commerce — Server Environment Variables (Production Template)

PORT=5000
NODE_ENV=production
DATABASE_URL=postgresql://nexus_user:nexus_password@localhost:5432/nexus_db?schema=public
SESSION_SECRET=replace_with_a_super_secret_key_at_least_32_chars_long
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379

# Payment Providers (Phase 5)
# A key containing a placeholder marker (REPLACE_ME, xxxx, your_, example, ...)
# counts as NOT configured. The providers then refuse to take a payment rather
# than simulating one: an earlier version called the gateway with a bogus key,
# got an error, and reported the payment as successful anyway.
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_ME
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-REPLACE_ME
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-REPLACE_ME
FLUTTERWAVE_WEBHOOK_SECRET=

# Simulated payments, for local development and the test suite.
#
# Opt-in only, and the factory throws if it is set while NODE_ENV=production,
# so it cannot be switched on for a live deployment. Everything it produces is
# flagged `simulated`, and the confirmation page says "no money moved" instead
# of "payment confirmed". Leave it unset to have checkout refuse payment until
# a real key is in place.
PAYMENTS_SANDBOX=false
SANDBOX_WEBHOOK_SECRET=

# Transactional Email (Phase 6)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.nexuscommerce.io
SMTP_PASS=smtp_password_placeholder
EMAIL_FROM="Nexus Commerce <no-reply@nexuscommerce.io>"

# OAuth Credentials (Phase 1/2)
GOOGLE_CLIENT_ID=google_client_id_placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=google_client_secret_placeholder
GITHUB_CLIENT_ID=github_client_id_placeholder
GITHUB_CLIENT_SECRET=github_client_secret_placeholder

# Voice (Nexus IQ)
# Speech recognition runs on this server, so nothing spoken leaves it. The
# model downloads on first use into VOICE_MODEL_DIR (default: server/.models).
# base.en is the default; tiny.en is faster and mishears more, small.en is
# slower and mishears less.
WHISPER_MODEL=onnx-community/whisper-base.en
VOICE_MODEL_DIR=.models
