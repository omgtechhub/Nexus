<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static sitemap: the pages that exist regardless of catalogue contents.

  Deliberately NOT generated per product. Nexus is a client-rendered SPA with
  no prerendering, so a crawler that does not execute JavaScript sees an empty
  shell on a product URL — listing thousands of them would advertise pages that
  look empty when fetched, which is worse than not listing them. Making product
  pages genuinely indexable needs SSR or prerendering first; that is a real
  piece of work, not a sitemap entry.

  Replace the host at deploy time; `<lastmod>` is the date this file was last
  revised by hand.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://nexuscommerce.io/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://nexuscommerce.io/products</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://nexuscommerce.io/products/browse</loc>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://nexuscommerce.io/pricing</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://nexuscommerce.io/contact</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>https://nexuscommerce.io/privacy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://nexuscommerce.io/terms</loc>
    <changefreq>yearly</changefreq>
