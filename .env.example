# Nexus Commerce — Frontend Environment Variables (Production Template)

# Base URL for the backend API endpoint.
#
# Leave this relative for local development. A relative path resolves against
# the origin serving the page, so the same value works on localhost, on a
# phone over a forwarded port, and inside a container; Vite's `/api` proxy
# hands the request to the backend. An absolute http://localhost:... URL
# breaks every client that is not the machine running the server.
#
# Set an absolute URL ONLY for a production build whose API lives on another
# origin, e.g. VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=/api
VITE_APP_NAME="Nexus Commerce"
VITE_PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_ME

# Support WhatsApp number, in full international form (digits only — the
# leading + and any spaces are stripped). Leave it blank and the floating
# WhatsApp button is not rendered at all, rather than linking to nobody.
VITE_WHATSAPP_NUMBER=2347084321204

# ---------------------------------------------------------------------------
# Deployment (docker compose reads this same file)
# ---------------------------------------------------------------------------
# These are consumed by docker-compose.yml, not by Vite. Compose refuses to
# start when one marked required is missing, rather than booting a stack with a
# placeholder secret — which is what the committed compose file used to do.

# Port the SPA is published on.
HTTP_PORT=80

# Sub-path deploys: VITE_BASE=/nexus/ for http://host/nexus/. Leave as / at the
# site root. Vite inlines this at BUILD time, so changing it needs a rebuild.
VITE_BASE=/

# --- Database (required) ---
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=
POSTGRES_DB=nexus_db

# --- Redis (required) ---
REDIS_PASSWORD=

# --- API (required) ---
# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The browser-facing origin, comma-separated for several. CORS and the CSRF
# origin guard are both built from this.
#
# MUST be https:// in production. The session cookie is SameSite=None; Secure
# on a production build, so a browser silently discards it over plain http and
# every login appears to succeed and then fail.
FRONTEND_URL=https://yourdomain.com

# Reverse proxy hop count. 1 behind the bundled nginx; 2 with a CDN in front
# of it; 0 when the API is exposed directly. Not a boolean — see config/index.ts.
TRUST_PROXY=1

# --- Payments ---
# Webhook secrets are separate from the API keys. Paystack signs with the
# secret key, so PAYSTACK_WEBHOOK_SECRET may be left blank. Flutterwave uses
# the dashboard "secret hash", which has NO fallback: leave it empty and every
# Flutterwave webhook is rejected 401 and those orders never confirm.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Email (required in production) ---
# The API refuses to boot in production without usable credentials, because a
# dead transport means no password resets and no email verification, with no
# visible symptom until a user reports it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Nexus Commerce <no-reply@yourdomain.com>"

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Also needed by the frontend build for the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Trading currency ---
# The currency new stores are created in, and the fallback for a payment with
# none. ISO code: NGN, GHS, KES, ZAR or USD.
#
# This matters more than it looks. Paystack REJECTS a transaction in a currency
# the merchant account has not enabled, so a Nigerian account left on the USD
# default fails every checkout at initialize with "Currency not supported by
# merchant" — no order can ever be paid. Set this to match the gateway account
# the money actually lands in.
#
# Unset = USD, which is what every existing store was created with. Existing
# stores keep their own value; this only affects new ones.
DEFAULT_CURRENCY=USD

# --- Background jobs ---
# Subscription renewals, grace periods and abandoned-checkout stock release run
# on an in-process interval. The queue has no persistence, so EVERY instance
# runs every job. The jobs are written to tolerate that (each claims its row
# before acting), but if you run more than one API replica, set this to false
# on all but one.
SCHEDULER_ENABLED=true

# --- Sales tax ---
# Charged on every order, platform-wide. Nexus is one marketplace: it takes the
# money and issues the receipt, so tax is a platform decision, not something a
# merchant sets.
#
# 0 or unset means no tax is charged. Set a percentage (e.g. 7.5) and a label
# that matches what the receipt should say.
PLATFORM_TAX_PERCENT=0
PLATFORM_TAX_LABEL=Tax
# true when listed prices already include the tax.
PLATFORM_TAX_INCLUSIVE=false

# --- Merchant payouts ---
# The platform's cut of each merchant sale, as a percentage (e.g. 2.5).
#
# DEFAULTS TO 0, deliberately: a commission is a commercial term between the
# platform and its merchants, and inventing one would quietly withhold money
# from people who never agreed to it. At 0 the platform's only revenue is
# subscriptions.
#
# The rate is captured on each payment as it settles, so changing this affects
# NEW sales only — money already taken is never re-valued.
#
# Payouts are RECORDED, not executed: nothing in the codebase transfers money
# to a merchant. See server/src/services/payouts/README.md.
PLATFORM_COMMISSION_PERCENT=5

# --- Voice ---
# --- Voice (Nexus IQ) ---
# Speech recognition runs in worker threads, not on the API's main thread.
# Inference is ~1.3s of solid CPU per command; run inline it blocked every
# other request on the server for that whole time.
#
# Each worker holds its own copy of the model (~76MB for base.en), so the
# memory cost is roughly VOICE_WORKERS x model size. 2 is right for a single
# instance: enough that one slow command does not stall the next, without
# doubling the container's memory for a bursty feature.
VOICE_WORKERS=2
# Per-clip ceiling before the caller is told it failed.
VOICE_TIMEOUT_MS=60000
# Queued clips beyond this are refused with a 503 rather than silently
# delayed. An unbounded queue accepts work faster than it can ever be done.
VOICE_MAX_QUEUE=12

WHISPER_MODEL=onnx-community/whisper-base.en
VOICE_MODEL_DIR=.models
